# Copy to .env and adjust for your environment.
# DATABASE_URL: PostgreSQL connection string used by Prisma and the pg driver adapter.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saints_crm?schema=public"
# AUTH_SECRET: 32 random bytes, base64 encoded. Signs the NextAuth session JWT.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-base64-secret"
